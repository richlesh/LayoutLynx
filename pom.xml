<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.glowingcat</groupId>
    <artifactId>LayoutLynx-parent</artifactId>
    <version>1.4.0</version>
    <packaging>pom</packaging>

    <name>LayoutLynx Parent</name>

    <properties>
        <app.version>1.4.0</app.version>
        <copyright.years>2026</copyright.years>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <commonmark.version>0.24.0</commonmark.version>
        <javafx.version>21.0.13</javafx.version>
        <javafx.scope>provided</javafx.scope>
    </properties>

    <profiles>
        <!-- OS-activated profiles that set the OpenJFX native classifier.
             aichat/pom.xml references <classifier>${javafx.platform}</classifier>
             on every JavaFX dependency, so this property MUST be defined or the
             build fails with "Unresolved dependency ... :${javafx.platform}".
             These activate automatically based on the build host; override with
             -Djavafx.platform=<classifier> (e.g. for cross-platform packaging). -->
        <profile>
            <id>javafx-mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac-aarch64</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-win-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>win-aarch64</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-win-x86_64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux-aarch64</javafx.platform>
            </properties>
        </profile>
        <profile>
            <id>javafx-linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <javafx.platform>linux</javafx.platform>
            </properties>
        </profile>
        <!-- Active by default for local development — makes JavaFX available at runtime -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <javafx.scope>compile</javafx.scope>
            </properties>
        </profile>
        <!-- Use for release/packaging builds: mvn -P release -->
        <profile>
            <id>release</id>
            <properties>
                <javafx.scope>provided</javafx.scope>
            </properties>
        </profile>
        <!--
            Opt-in refresh of the bundled emoji datasets. Deliberately NOT part of the normal
            build so builds stay offline-capable and reproducible. Run manually to update the
            vendored data:

                mvn -Pupdate-emoji generate-resources
              (or directly:  ./scripts/update-emoji.sh)

            Regenerates both:
              app/src/main/resources/emoji.json.gz     (full gemoji Unicode dataset, gzipped)
              app/src/main/resources/github-emoji.json (image-only GitHub-custom shortcodes)
        -->
        <profile>
            <id>update-emoji</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>refresh-emoji</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/scripts/update-emoji.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <modules>
        <module>aichat</module>
        <module>app</module>
    </modules>
</project>
